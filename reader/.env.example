# ============================================================================
# 环境变量示例
# 复制为 .env 并填写实际值：cp .env.example .env
# （.env 已被 .gitignore 忽略，切勿提交真实密钥）
# ============================================================================

# ---- LLM 主模型（AI 方法引擎 / 对话问答） ----
# 任意 OpenAI 兼容接口（OpenAI / DeepSeek / 本地网关等）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ---- Embedding 模型（向量检索） ----
# 本地 Ollama：EMBEDDING_BASE_URL=http://localhost:11434/v1 + EMBEDDING_MODEL=qwen3-embedding:0.6b
#（Ollama OpenAI 兼容端点，apiKey 占位即可；中文场景 qwen3-embedding 优于 bge-m3）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=qwen3-embedding:0.6b
